<section class="cub4-hero color-{{ section.settings.color_scheme }} gradient">
<div class="page-width cub4-hero__grid">
<div class="cub4-hero__copy">
<p class="cub4-eyebrow">{{ section.settings.eyebrow | escape }}</p>
<h1>{{ section.settings.heading | escape }}</h1>
<div class="rte cub4-hero__text">{{ section.settings.text }}</div>
{% if section.settings.label != blank %}<a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
</div>
<div class="cub4-hero__visual">
{% if section.settings.image != blank %}
{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1400', sizes: '(min-width: 990px) 45vw, 90vw', loading: 'eager', class: 'cub4-hero__image' }}
{% else %}<div class="cub4-orbit" aria-hidden="true"><div class="cub4-orbit__circle"></div><img src="{{ 'cub4-icon-transparent.png' | asset_url }}" width="320" height="320" alt=""><span class="cub4-orbit__label">{{ section.settings.visual_label | escape }}</span></div>{% endif %}
</div></div></section>
{% schema %}
{
  "name": "cub4 · Vitrine principal",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "CUB4STUDIO / STORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Encontre o seu próximo favorito."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição",
      "default": "<p>Novas ideias, descobertas e produtos para fazer parte da sua rotina.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do botão",
      "default": "Explorar produtos"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do botão"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem principal"
    },
    {
      "type": "text",
      "id": "visual_label",
      "label": "Texto da arte de marca",
      "default": "ESCOLHAS. DESCOBERTAS. CUB4."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Cores",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "cub4 · Vitrine principal"
    }
  ]
}
{% endschema %}
